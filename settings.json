{
  "security": {
    "folderTrust": {
      "enabled": true
    },
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "tools": {
    "autoAccept": true,
    "exclude": [
      "run_shell_command(rm)",
      "run_shell_command(rm -rf)",
      "run_shell_command(sudo)",
      "run_shell_command(chmod)",
      "run_shell_command(chown)",
      "run_shell_command(mv)",
      "run_shell_command(del)",
      "run_shell_command(rmdir)",
      "run_shell_command(sed -i)",
      "run_shell_command(cat secure)",
      "run_shell_command(cat */secure/*)",
      "ReadFileTool(secure)",
      "ReadFileTool(**/secure/*)"
    ]
  },
  "mcpServers": {
    "context7": {
      "httpUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    }
  },
  "context": {
    "fileName": [
      "AGENTS.md"
    ],
    "fileFiltering": {
      "respectGitIgnore": true,
      "ignorePatterns": [
        "**/secure/**",
        "secure/",
        "**/application.yml",
        "**/.env"
      ]
    }
  },
  "general": {
    "previewFeatures": true
  }
}
