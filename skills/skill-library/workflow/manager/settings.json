{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(bun test *)",
      "Bash(bun run *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "mcp__vibe_kanban__*"
    ]
  },
  "mcpServers": {
    "vibe_kanban": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "vibe-kanban@latest", "--mcp"]
    }
  }
}
